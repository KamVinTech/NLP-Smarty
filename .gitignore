# ── Virtual Environment ────────────────────────────────────────────────────────
NLP-start/

# ── Python Bytecode & Cache ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Distribution / Build ───────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── spaCy Models (downloaded at runtime) ──────────────────────────────────────
en_core_web_*/

# ── HuggingFace / Torch Cache ─────────────────────────────────────────────────
.cache/
~/.cache/huggingface/
*.pt
*.bin
*.safetensors

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key

# ── Jupyter Notebooks Checkpoints ─────────────────────────────────────────────
.ipynb_checkpoints/

# ── Test & Coverage Artifacts ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── IDE & OS Noise ────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
Thumbs.db

node_modules/

# ── Compiled / packaged output (rebuilt by CI, never committed) ───────────────
out/
*.vsix
*.tsbuildinfo
.venv/
venv/

# ── Local runtime state: personal, machine-specific, or regenerated ───────────
*.log
.nlp_smarty_optimization.log
.smarty/
.claude/
.mcp.json
*.smarty-bak
*.smarty-tmp
coverage.xml
